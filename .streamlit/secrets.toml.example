# Streamlit Cloud secrets — template only.
# In Streamlit Cloud dashboard → your app → Settings → Secrets, paste:
#
#   UNMAPPED_API_URL = "https://unmapped-api.onrender.com/api"
#
# Replace the URL with whatever Render assigns when you deploy the backend.
# This file is committed (it's only an example with no real values).
# The actual secrets.toml is git-ignored.

UNMAPPED_API_URL = "https://YOUR-RENDER-APP.onrender.com/api"
